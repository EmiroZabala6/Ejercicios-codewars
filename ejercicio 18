import java.util.*;

class DoubleLinear {
    public static int dblLinear(int n) {
        TreeSet<Integer> set = new TreeSet<>();
        set.add(1);
        for (int i = 0; i < n; i++) {
            int x = set.pollFirst();
            set.add(2 * x + 1);
            set.add(3 * x + 1);
        }
        return set.first();
    }
}
